PORT=3000
JWT_SECRET=replace-with-a-long-random-secret
AUTH_USERNAME=admin
AUTH_PASSWORD=replace-with-a-strong-password
POUCHDB_PATH=./data/lobster-farm-monitor

# dummy: seed demo readings; mqtt: subscribe to real sensor readings
SENSOR_MODE=dummy

# Required when SENSOR_MODE=mqtt
MQTT_URL=mqtt://localhost:1883
MQTT_TOPIC=lobster-farm/sensors
MQTT_USERNAME=
MQTT_PASSWORD=

# Optional Telegram alerts
TELEGRAM_BOT_TOKEN=
