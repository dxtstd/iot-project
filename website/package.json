{
  "name": "lobster-farm-monitor",
  "private": true,
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev": "nx run-many --target=dev --projects=backend,frontend --parallel=2",
    "build": "nx run-many --target=build --projects=backend,frontend --parallel=2",
